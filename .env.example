# Application Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/webhook_delivery?schema=public

# Queue & Cache (Redis)
REDIS_URL=redis://localhost:6381

# Worker Configuration
WORKER_CONCURRENCY=10
DELIVERY_TIMEOUT_MS=10000
MAX_DELIVERY_ATTEMPTS=8

# Security & Secrets
API_KEY_SALT=development_super_secret_salt_12345
