generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DeliveryStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  DEAD_LETTER
}

enum CircuitStatus {
  CLOSED
  OPEN
  HALF_OPEN
}

model Customer {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  apiKeys         ApiKey[]
  endpoints       Endpoint[]
  events          Event[]
  deliveries      Delivery[]
  idempotencyKeys IdempotencyKey[]

  @@map("customers")
}

model ApiKey {
  id          String    @id @default(uuid())
  customerId  String    @map("customer_id")
  name        String
  keyHash     String    @unique @map("key_hash")
  keyPrefix   String    @map("key_prefix")
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  customer    Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("api_keys")
}

model Endpoint {
  id                  String         @id @default(uuid())
  customerId          String         @map("customer_id")
  url                 String
  description         String?
  secret              String         // HMAC secret for signing delivery payloads
  eventTypes          String[]       @default(["*"]) @map("event_types")
  enabled             Boolean        @default(true)
  circuitStatus       CircuitStatus  @default(CLOSED) @map("circuit_status")
  failureCount        Int            @default(0) @map("failure_count")
  circuitOpenedAt     DateTime?      @map("circuit_opened_at")
  rateLimitPerSecond  Int            @default(50) @map("rate_limit_per_second")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  customer            Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deliveries          Delivery[]

  @@index([customerId])
  @@index([customerId, enabled])
  @@map("endpoints")
}

model Event {
  id          String     @id @default(uuid())
  customerId  String     @map("customer_id")
  eventType   String     @map("event_type")
  payload     Json
  createdAt   DateTime   @default(now()) @map("created_at")

  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deliveries  Delivery[]

  @@index([customerId, createdAt(sort: Desc)])
  @@index([customerId, eventType])
  @@map("events")
}

model Delivery {
  id            String            @id @default(uuid())
  customerId    String            @map("customer_id")
  eventId       String            @map("event_id")
  endpointId    String            @map("endpoint_id")
  status        DeliveryStatus    @default(PENDING)
  attemptCount  Int               @default(0) @map("attempt_count")
  maxAttempts   Int               @default(8) @map("max_attempts")
  nextRetryAt   DateTime?         @map("next_retry_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint      Endpoint          @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  attempts      DeliveryAttempt[]

  @@index([customerId, status])
  @@index([endpointId, status])
  @@index([eventId])
  @@index([status, nextRetryAt])
  @@map("deliveries")
}

model DeliveryAttempt {
  id                  String    @id @default(uuid())
  deliveryId          String    @map("delivery_id")
  attemptNumber       Int       @map("attempt_number")
  statusCode          Int?      @map("status_code")
  latencyMs           Int       @map("latency_ms")
  success             Boolean
  error               String?
  requestHeaders      Json?     @map("request_headers")
  responseHeaders     Json?     @map("response_headers")
  responseBodySnippet String?   @map("response_body_snippet")
  createdAt           DateTime  @default(now()) @map("created_at")

  delivery            Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, attemptNumber])
  @@map("delivery_attempts")
}

model IdempotencyKey {
  id           String    @id @default(uuid())
  customerId   String    @map("customer_id")
  key          String
  requestPath  String    @map("request_path")
  requestHash  String    @map("request_hash")
  statusCode   Int?      @map("status_code")
  responseBody Json?     @map("response_body")
  eventId      String?   @map("event_id")
  lockedUntil  DateTime? @map("locked_until")
  createdAt    DateTime  @default(now()) @map("created_at")
  expiresAt    DateTime  @map("expires_at")

  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}
